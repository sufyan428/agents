# Router Monitoring Agent - Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# Agent Configuration
# ============================================
PORT=3000
LOG_LEVEL=info

# ============================================
# Email Alerts Configuration
# ============================================
# SMTP Server Host
SMTP_HOST=smtp.gmail.com

# SMTP Server Port
SMTP_PORT=587

# SMTP Username (your email address)
SMTP_USER=your-email@example.com

# SMTP Password (use App Password for Gmail)
SMTP_PASS=your-app-password

# Email From Address
SMTP_FROM=monitoring-agent@example.com

# Email Recipient for Alerts
ALERT_EMAIL_RECIPIENT=admin@example.com

# ============================================
# API Webhook Configuration
# ============================================
# External API endpoint to send alerts to
# Example: https://your-monitoring-system.com/api/alerts
ALERT_API_ENDPOINT=

# ============================================
# Optional: Additional Configuration
# ============================================
# Metrics port (if different from main port)
METRICS_PORT=9090

# Node environment
NODE_ENV=production

# Timezone
TZ=UTC