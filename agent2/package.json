{
  "name": "resilience-failover-agent",
  "version": "1.0.0",
  "description": "Router Resilience & Failover Agent with SNMP, ICMP, and Syslog monitoring",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node src/test/test.js",
    "docker:build": "docker build -t resilience-failover-agent .",
    "docker:run": "docker run -p 9090:9090 -p 514:514/udp -v $(pwd)/config:/app/config resilience-failover-agent"
  },
  "keywords": [
    "router",
    "failover",
    "snmp",
    "monitoring",
    "prometheus",
    "high-availability"
  ],
  "author": "sufiyansrepos",
  "license": "MIT",
  "dependencies": {
    "@ragent/agent-common": "1.0.0",
    "@ragent/agent-protocol": "1.0.0",
    "axios": "^1.8.4",
    "express": "^4.21.2",
    "js-yaml": "^5.3.0",
    "node-cron": "^4.2.1",
    "ping": "^0.4.4",
    "prom-client": "^15.1.3",
    "snmp-native": "^1.2.0",
    "syslog-client": "^1.1.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
