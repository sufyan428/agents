# Router Configuration for Resilience & Failover Agent
# Copy this file to router.yml and update with your router details

# Primary Router Configuration
primary:
  host: "192.168.1.1"
  port: 161
  community: "public"
  timeout: 5000
  retries: 3
  version: "2c"
  # Optional NETCONF/RESTCONF
  netconf:
    enabled: false
    port: 830
    username: "admin"
    password: "password"
  restconf:
    enabled: false
    port: 443
    username: "admin"
    password: "password"
    protocol: "https"

# Backup Router Configuration
backup:
  host: "192.168.1.2"
  port: 161
  community: "public"
  timeout: 5000
  retries: 3
  version: "2c"
  # Optional NETCONF/RESTCONF
  netconf:
    enabled: false
    port: 830
    username: "admin"
    password: "password"
  restconf:
    enabled: false
    port: 443
    username: "admin"
    password: "password"
    protocol: "https"

# Failover Settings
failover:
  enabled: true
  heartbeat_interval: 5000  # milliseconds
  max_missed_heartbeats: 3  # Number of missed heartbeats before failover
  failback_enabled: true
  failback_delay: 30000     # milliseconds to wait before failback
  auto_failback: true       # Automatically failback when primary recovers
  notification_enabled: true

# Monitoring Settings
monitoring:
  snmp_oids:
    - "1.3.6.1.2.1.1.3.0"    # System uptime
    - "1.3.6.1.2.1.1.5.0"    # System name
    - "1.3.6.1.2.1.1.1.0"    # System description
    - "1.3.6.1.2.1.2.2.1.10" # Interface bytes in
    - "1.3.6.1.2.1.2.2.1.16" # Interface bytes out
  ping_interval: 10000       # milliseconds
  ping_count: 4
  ping_timeout: 2000         # milliseconds

# Configuration Sync Settings
sync:
  enabled: true
  sync_interval: 60000       # milliseconds (1 minute)
  sync_on_failover: true
  sync_on_failback: true
  sync_commands:
    - "show running-config"
    - "show interface status"
    - "show version"
  backup_path: "/app/data/config-backups"

# Syslog Settings
syslog:
  enabled: true
  port: 514
  protocol: "udp"
  facility: "local0"
  severity: "info"
  log_format: "json"

# Logging Settings
logging:
  level: "info"
  directory: "/app/logs"
  max_size: "20m"
  max_files: "14d"
  date_pattern: "YYYY-MM-DD"

# Metrics Settings
metrics:
  enabled: true
  port: 9090
  endpoint: "/metrics"
  health_endpoint: "/health"

# State Persistence
state:
  enabled: true
  file: "/app/data/state.json"
  save_interval: 10000

# Alert Thresholds
alerts:
  cpu_threshold: 80          # percentage
  memory_threshold: 80       # percentage
  interface_error_threshold: 100
  response_time_threshold: 1000 # milliseconds

# Advanced Settings
advanced:
  graceful_shutdown: true
  shutdown_timeout: 30000    # milliseconds
  startup_delay: 5000        # milliseconds before starting monitoring
  enable_debug: false