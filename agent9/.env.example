# Standalone configuration for agent9.
#
# Normally you do not need this file: put your key in agent6/.env and the
# orchestrator passes it to every AI agent it starts. This is only for running
# agent9 on its own.

AI_API_KEY=
AI_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
AI_BASE_URL=https://openrouter.ai/api/v1

# 0 disables this agent's model use entirely.
AI_DAILY_CALL_BUDGET=500

AGENT_API_TOKEN=
