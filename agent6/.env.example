# Shared configuration for the optional AI layer (agents 7-10).
#
# Agents 1-6 never make an AI call and need nothing here. The framework
# detects, correlates and ranks incidents without a key - see
# GET /api/incidents on the orchestrator.

# ---- required to enable agents 7-10 ----------------------------------------
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Any OpenAI-compatible endpoint. Some examples:
#   OpenRouter   https://openrouter.ai/api/v1                                 (default)
#   Gemini       https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama       http://localhost:11434/v1                                    (local, no key needed)
AI_BASE_URL=https://openrouter.ai/api/v1

# For Anthropic's native API instead, set this and omit AI_BASE_URL:
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5

# ---- spend control, enforced locally before any request goes out ------------
# 0 disables the AI layer entirely without changing anything else.
AI_DAILY_CALL_BUDGET=500
AI_DAILY_TOKEN_BUDGET=0

# ---- control-plane auth -----------------------------------------------------
# Required for any endpoint that starts, stops or restarts an agent, triggers a
# failover, or reloads configuration. Without it those refuse with 503.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_API_TOKEN=

# ---- optional ---------------------------------------------------------------
# Comma-separated origins allowed to call the APIs from a browser. Empty means
# no cross-origin access at all.
# AGENT_CORS_ORIGINS=

# Bind address. Loopback by default; anything else needs auth and TLS in front.
# BIND_HOST=127.0.0.1
