{
  "name": "router-framework-orchestrator",
  "version": "1.0.0",
  "description": "Framework Orchestrator Agent - Unified management for all 5 router monitoring agents",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "install-all": "bash scripts/install-all.sh",
    "start-all": "docker-compose up -d",
    "stop-all": "docker-compose down",
    "logs": "docker-compose logs -f"
  },
  "keywords": [
    "router",
    "orchestrator",
    "framework",
    "monitoring",
    "unified",
    "management"
  ],
  "author": "sufiyansrepos",
  "license": "MIT",
  "dependencies": {
    "@ragent/agent-common": "0.1.0",
    "@ragent/agent-protocol": "0.1.0",
    "@ragent/analytics": "0.1.0",
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "node-cron": "^4.2.1",
    "prom-client": "^15.1.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
